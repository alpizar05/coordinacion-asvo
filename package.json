{
  "name": "coordinacion-asvo",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "db:setup": "node --env-file=.env.local scripts/db.mjs",
    "db:start": "node --env-file=.env.local scripts/local-postgres.mjs",
    "mail:retry": "node --env-file=.env.local scripts/mail-outbox.mjs",
    "mail:worker": "node --env-file=.env.local scripts/mail-outbox.mjs --watch",
    "test:registration": "node --env-file=.env.local scripts/test-integration.mjs --only=registration",
    "test:navigation:unit": "node --test --import ./tests/navigation/register.mjs tests/navigation/*.test.mjs",
    "test:navigation:coverage": "node --test --experimental-test-coverage --test-coverage-include='lib/navigation*.ts' --import ./tests/navigation/register.mjs tests/navigation/*.test.mjs",
    "db:migrate": "node --env-file=.env.local scripts/db.mjs",
    "db:migrate:history": "node --env-file=.env.local scripts/db-history.mjs",
    "db:seed:demo": "node --env-file=.env.local scripts/demo-registro.mjs",
    "db:seed:calendar": "node --env-file=.env.local scripts/demo-calendario-noviembre.mjs",
    "db:seed:groups": "node --env-file=.env.local scripts/demo-agrupaciones.mjs",
    "db:seed:attendance": "node --env-file=.env.local scripts/demo-attendance-reconciliation.mjs",
    "test:db:commands": "node --env-file=.env.local scripts/test-db-commands.mjs",
    "db:status": "node --env-file=.env.local scripts/db.mjs --status",
    "db:plan": "node --env-file=.env.local scripts/db.mjs --plan",
    "db:adopt": "node --env-file=.env.local scripts/db.mjs --adopt",
    "test:db:migrations": "node --env-file=.env.local scripts/test-schema-migrations.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:unit:coverage": "node scripts/test-unit.mjs --coverage",
    "test:integration": "node --env-file=.env.local scripts/test-integration.mjs",
    "test:contracts": "node scripts/test-contracts.mjs",
    "test:authorization:inventory": "node scripts/audit-authorization.mjs",
    "photos:cleanup:plan": "node --env-file=.env.local scripts/photo-cleanup.mjs --plan",
    "photos:cleanup": "node --env-file=.env.local scripts/photo-cleanup.mjs --apply",
    "mail:review": "node --env-file=.env.local scripts/mail-review.mjs",
    "config:check": "node --env-file=.env.local scripts/check-config.mjs --mode=development",
    "test:security:build": "node scripts/test-security-build.mjs",
    "lint": "biome lint --error-on-warnings app lib scripts tests next.config.ts",
    "format:check": "prettier --check .github/workflows/ci.yml biome.json .prettierrc.json .secretlintrc.json package.json package-lock.json \"scripts/ci/**/*.{mjs,json}\" \"tests/ci/**/*.mjs\" docs/ci-y-equivalencia.md",
    "test:ci": "node --test tests/ci/*.test.mjs",
    "test:integration:ci": "node scripts/ci/integration.mjs",
    "security:secrets": "node scripts/ci/secrets.mjs",
    "security:dependencies": "node scripts/ci/dependencies.mjs",
    "ci:install:verify": "node scripts/ci/clean-install.mjs",
    "ci:typecheck": "node scripts/ci/typecheck.mjs"
  },
  "type": "module",
  "dependencies": {
    "csv-parse": "^7.0.3",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "3.10.1",
    "secretlint": "13.1.0",
    "typescript": "^7.0.2",
    "yaml": "2.9.1"
  },
  "private": true,
  "packageManager": "npm@11.7.0"
}
